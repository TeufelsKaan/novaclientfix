{
  "name": "nova-client",
  "version": "0.6.0",
  "private": true,
  "description": "Nova Client — Windows Minecraft Java launcher with multiple loaders, modpacks and HUD mods.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:hud-mod": "nova-hud-mod\\gradlew.bat -p nova-hud-mod build && node scripts/copy-hud-mod.cjs",
    "web:dev": "vite website --host 127.0.0.1",
    "web:build": "vite build website --config website/vite.config.cjs --outDir dist --emptyOutDir",
    "build:icon": "node scripts/create-icon.cjs",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build:icon && npm run build:hud-mod && npm run web:build && electron-builder --config electron-builder.config.cjs --win nsis --publish never",
    "package:dir": "npm run build:icon && electron-builder --config electron-builder.config.cjs --win dir --publish never",
    "deploy:cloudflare": "npx wrangler@latest deploy --config wrangler.toml",
    "deploy:vercel": "npx vercel@latest --prod .",
    "check:ui": "electron scripts/check-ui.cjs",
    "check:updater": "electron scripts/check-updater.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.8.11",
    "eml-lib": "^2.2.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "gg.nova.client",
    "productName": "Nova Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "launcher/**/*",
      "lib/**/*",
      "assets/**/*",
      "website/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/nova-icon.ico",
      "artifactName": "Nova-Client-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/nova-icon.ico",
      "uninstallerIcon": "assets/nova-icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Client"
    }
  }
}
