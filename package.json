{
  "name": "nova-client",
  "version": "0.3.2",
  "private": true,
  "description": "Nova Client — Windows Minecraft Java launcher with Fabric and HUD mods.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:hud-mod": "nova-hud-mod\\gradlew.bat -p nova-hud-mod build && node scripts/copy-hud-mod.cjs",
    "web:dev": "vite website --host 127.0.0.1",
    "web:build": "vite build website --outDir ../dist-website --emptyOutDir",
    "test": "node --test",
    "package:win": "npm run build:hud-mod && npm run web:build && electron-builder --config electron-builder.config.cjs --win nsis --publish never",
    "package:dir": "electron-builder --config electron-builder.config.cjs --win dir --publish never",
    "deploy:cloudflare": "npx wrangler@latest deploy --config wrangler.toml",
    "deploy:vercel": "npx vercel@latest --prod ./website",
    "check:ui": "electron scripts/check-ui.cjs",
    "check:updater": "electron scripts/check-updater.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "eml-lib": "^2.2.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "gg.nova.client",
    "productName": "Nova Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "launcher/**/*",
      "lib/**/*",
      "website/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Nova-Client-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Client"
    }
  }
}
